# Agentic-shop backend configuration. Copy to .env and fill in real values.
# NEVER commit .env or any real key.

# "mock" runs the whole pipeline with no API key and no network (default).
# "real" uses the OpenCode gateway via the OpenAI-compatible client.
LLM_MODE=mock

# Only required when LLM_MODE=real. Pick a model id from your plan's /models.
# Free OpenCode Zen models include muse-spark-1.2-contributor-free,
# mimo-v2.5-free, nemotron-3.5-lightning-free, hy3-free, big-pickle.
LLM_MODEL=
OPENCODE_BASE_URL=
OPENCODE_API_KEY=

# "auto" (default) uses the standard chat-completions path. Set "responses"
# for models that only expose the OpenAI Responses API (e.g.
# muse-spark-1.2-contributor-free on OpenCode Zen).
LLM_API_STYLE=auto

# Which client transports real-mode calls (DECISIONS.md D8):
#   openai (default) — the generic OpenAI-compatible client.
#   zai              — Z.ai's official SDK. Pair with
#                      OPENCODE_BASE_URL=https://api.z.ai/api/paas/v4 and a
#                      Z.ai model id (e.g. glm-5.3-flash) in LLM_MODEL.
LLM_SDK=openai

# TypeSafe Jev judgment layer (DECISIONS.md D9) — intent extraction as one
# batched typed-decision request instead of an LLM call.
#   off  (default) — intent runs through the LLM path above, unchanged.
#   mock           — deterministic keyless judgments (CI default behavior).
#   real           — calls api.typesafe.ai; requires JEV_API_KEY.
JEV_MODE=off
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
