# Agentic-shop backend configuration. Copy to .env and fill in real values.
# NEVER commit .env or any real key.

# "mock" runs the whole pipeline with no API key and no network (default).
# "real" uses the OpenCode gateway via the OpenAI-compatible client.
LLM_MODE=mock

# Only required when LLM_MODE=real. Pick a model id from your plan's /models.
LLM_MODEL=
OPENCODE_BASE_URL=
OPENCODE_API_KEY=
