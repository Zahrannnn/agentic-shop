# Agentic-shop backend configuration. Copy to .env and fill in real values.
# NEVER commit .env or any real key.

# "mock" runs the whole pipeline with no API key and no network (default).
# "real" uses the OpenCode gateway via the OpenAI-compatible client.
LLM_MODE=mock

# Only required when LLM_MODE=real. Pick a model id from your plan's /models.
# Free OpenCode Zen models include muse-spark-1.2-contributor-free,
# mimo-v2.5-free, nemotron-3.5-lightning-free, hy3-free, big-pickle.
LLM_MODEL=
OPENCODE_BASE_URL=
OPENCODE_API_KEY=

# "auto" (default) uses the standard chat-completions path. Set "responses"
# for models that only expose the OpenAI Responses API (e.g.
# muse-spark-1.2-contributor-free on OpenCode Zen).
LLM_API_STYLE=auto
